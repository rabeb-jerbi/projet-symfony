{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 650px;">
  <h1 class="mb-4">Créer un compte</h1>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ label }}">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  {{ form_start(registrationForm) }}

    <div class="mb-3">
      {{ form_row(registrationForm.nom) }}
    </div>

    <div class="mb-3">
      {{ form_row(registrationForm.email) }}
    </div>

    <div class="mb-3">
      {{ form_row(registrationForm.adresse) }}
    </div>

    <div class="mb-3">
      {{ form_row(registrationForm.numTeleph) }}
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        {{ form_row(registrationForm.plainPassword.first) }}
      </div>
      <div class="col-md-6 mb-3">
        {{ form_row(registrationForm.plainPassword.second) }}
      </div>
    </div>

    <button class="btn btn-primary w-100">S’inscrire</button>

  {{ form_end(registrationForm) }}

  <p class="mt-3">
    Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
  </p>
</div>
{% endblock %}
