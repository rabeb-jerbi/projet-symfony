<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Karhabti{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="{{ path('app_home') }}">Karhabti</a>

    <div class="collapse navbar-collapse">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_catalogue') }}">Catalogue</a>
        </li>

        {% if is_granted('ROLE_CLIENT') %}
          <li class="nav-item">
            <a class="nav-link" href="{{ path('client_dashboard') }}">Dashboard client</a>
          </li>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
          <li class="nav-item">
            <a class="nav-link" href="{{ path('admin_dashboard') }}">Dashboard admin</a>
          </li>
        {% endif %}
      </ul>

      <ul class="navbar-nav ms-auto">
        {% if app.user %}
          <li class="nav-item">
            <span class="navbar-text text-white me-3">
              {{ app.user.userIdentifier }}
            </span>
          </li>
          <li class="nav-item">
            <a class="btn btn-outline-light" href="{{ path('app_logout') }}">Logout</a>
          </li>
        {% else %}
          <li class="nav-item">
            <a class="btn btn-outline-light me-2" href="{{ path('app_login') }}">Login</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-warning" href="{{ path('app_register') }}">Register</a>
          </li>
        {% endif %}
      </ul>
    </div>
  </div>
</nav>

<div class="container py-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>
