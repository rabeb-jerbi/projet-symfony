{% extends 'base.html.twig' %}
{% block title %}Détails voiture{% endblock %}

{% block body %}
<div class="container py-4">
  <a href="{{ path('app_catalogue') }}" class="btn btn-outline-secondary mb-3">← Retour</a>

  <div class="card">
    <div class="card-body">
      <h3 class="card-title">{{ voiture.marque }} {{ voiture.modele }}</h3>
      <p class="mb-1"><b>Année:</b> {{ voiture.annee }}</p>
      <p class="mb-1"><b>Kilométrage:</b> {{ voiture.kilometrage }}</p>
      <p class="mb-1"><b>Prix achat:</b> {{ voiture.prixAchat }} DT</p>
      <p class="mb-3"><b>Prix location/jour:</b> {{ voiture.prixLocationJour }} DT</p>

      <span class="badge text-bg-{{ voiture.statut == 'disponible' ? 'success' : 'secondary' }}">
        {{ voiture.statut }}
      </span>
    </div>

    <div class="card-footer bg-white">
      {% if app.user and is_granted('ROLE_CLIENT') and voiture.statut == 'disponible' %}
        <div class="row g-2">
          <div class="col-md-6">
            <form method="post" action="{{ path('client_acheter', {id: voiture.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('buy' ~ voiture.id) }}">
              <button class="btn btn-success w-100">Acheter</button>
            </form>
          </div>

          <div class="col-md-6">
            <form method="post" action="{{ path('client_louer', {id: voiture.id}) }}" class="row g-2">
              <input type="hidden" name="_token" value="{{ csrf_token('rent' ~ voiture.id) }}">
              <div class="col-6">
                <input type="date" name="dateDebut" class="form-control" required>
              </div>
              <div class="col-6">
                <input type="date" name="dateFin" class="form-control" required>
              </div>
              <div class="col-12">
                <button class="btn btn-warning w-100">Louer</button>
              </div>
            </form>
          </div>
        </div>
      {% elseif not app.user %}
        <div class="alert alert-info m-3">
          Connecte-toi pour acheter ou louer.
          <a href="{{ path('app_login') }}">Se connecter</a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
